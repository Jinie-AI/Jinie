# These must be environment variables in your shell; no secrets are bundled.
# Optional, only after firebase login:
# JINIE_FIREBASE_PROJECT=your-firebase-project-id
# JINIE_DATA_DIR=/path/to/local/project-state

# Leave empty to keep SQLite. Use your private Atlas connection string.
MONGODB_URI=
MONGODB_DATABASE=jinie

# Optional product photo search; keep this key on the backend only.
UNSPLASH_ACCESS_KEY=

# Firebase Authentication (enable Email/Password in the console)
FIREBASE_WEB_API_KEY=
